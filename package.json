{
  "name": "sheet-agent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "test": "node --test tests/foundation/*.test.mjs tests/addin-shell/*.test.mjs && pnpm -r --if-present test",
    "test:foundation": "node --test tests/foundation/*.test.mjs",
    "typecheck": "tsc -b && turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "validate:manifest": "office-addin-manifest validate apps/addin/manifest/manifest.dev.xml && office-addin-manifest validate apps/addin/manifest/manifest.prod.xml"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "office-addin-manifest": "2.1.6",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
